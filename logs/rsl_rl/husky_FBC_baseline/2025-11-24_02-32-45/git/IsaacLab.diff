+def compute_success_rate(env, asset_cfg, command_name, position_threshold=0.05, orientation_threshold=0.2):
+    """
+    Метрика success rate для логирования.
+    Возвращает тензор (num_envs,): 1.0 если цель достигнута И это последний шаг, иначе 0.0
+    """
+    asset = env.scene[asset_cfg.name]
+    command = env.command_manager.get_command(command_name)
+    
+    des_pos_b = command[:, :3]
+    des_pos_w, _ = combine_frame_transforms(asset.data.root_pos_w, asset.data.root_quat_w, des_pos_b)
+    
+    if isinstance(asset_cfg.body_ids, slice):
+        curr_pos_w = asset.data.body_pos_w[:, asset_cfg.body_ids][:, 0]
+    else:
+        curr_pos_w = asset.data.body_pos_w[:, asset_cfg.body_ids[0]]
+    
+    position_error = torch.norm(curr_pos_w - des_pos_w, dim=1)
+    
+    des_quat_b = command[:, 3:7]
+    des_quat_w = quat_mul(asset.data.root_quat_w, des_quat_b)
+    
+    if isinstance(asset_cfg.body_ids, slice):
+        index = asset_cfg.body_ids.start or 0
+    else:
+        index = asset_cfg.body_ids[0]
+    
+    curr_quat_w = asset.data.body_quat_w[:, index]
+    orientation_error = quat_error_magnitude(curr_quat_w, des_quat_w)
+    
+    # Проверка достижения цели для ВСЕХ окружений
+    goal_reached = (position_error < position_threshold) & (orientation_error < orientation_threshold)
+    
+    # Проверка последнего шага для ВСЕХ окружений
+    max_episode_length = env.max_episode_length
+    is_final_step = (env.episode_length_buf >= max_episode_length - 1)
+    
+    # КЛЮЧЕВОЕ: применяем оба условия к тензору размера (num_envs,)
+    success = (goal_reached & is_final_step).float()
+    
+    return success  # Возвращаем тензор (num_envs,), Isaac Lab сам посчитает mean для логирования
